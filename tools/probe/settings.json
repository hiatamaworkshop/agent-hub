{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "http", "url": "http://127.0.0.1:7788/hook", "headers": { "X-Hub-Mailbox": "$HUB_MAILBOX", "X-Probe-Token": "$PROBE_TOKEN" }, "allowedEnvVars": ["HUB_MAILBOX", "PROBE_TOKEN"] }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "http", "url": "http://127.0.0.1:7788/hook", "headers": { "X-Hub-Mailbox": "$HUB_MAILBOX", "X-Probe-Token": "$PROBE_TOKEN" }, "allowedEnvVars": ["HUB_MAILBOX", "PROBE_TOKEN"] }] }
    ],
    "Notification": [
      { "hooks": [{ "type": "http", "url": "http://127.0.0.1:7788/hook", "headers": { "X-Hub-Mailbox": "$HUB_MAILBOX", "X-Probe-Token": "$PROBE_TOKEN" }, "allowedEnvVars": ["HUB_MAILBOX", "PROBE_TOKEN"] }] }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [{ "type": "http", "url": "http://127.0.0.1:7788/hook", "headers": { "X-Hub-Mailbox": "$HUB_MAILBOX", "X-Probe-Token": "$PROBE_TOKEN" }, "allowedEnvVars": ["HUB_MAILBOX", "PROBE_TOKEN"] }]
      }
    ]
  }
}
