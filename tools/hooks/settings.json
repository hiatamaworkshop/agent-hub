{
  "hooks": {
    "Stop": [
      { "hooks": [{ "type": "http", "url": "http://127.0.0.1:7777/events/claude-code", "timeout": 5, "headers": { "Authorization": "Bearer $HUB_TOKEN", "X-Hub-Mailbox": "$HUB_MAILBOX" }, "allowedEnvVars": ["HUB_TOKEN", "HUB_MAILBOX"] }] }
    ],
    "StopFailure": [
      { "hooks": [{ "type": "http", "url": "http://127.0.0.1:7777/events/claude-code", "timeout": 5, "headers": { "Authorization": "Bearer $HUB_TOKEN", "X-Hub-Mailbox": "$HUB_MAILBOX" }, "allowedEnvVars": ["HUB_TOKEN", "HUB_MAILBOX"] }] }
    ],
    "Notification": [
      { "hooks": [{ "type": "http", "url": "http://127.0.0.1:7777/events/claude-code", "timeout": 5, "headers": { "Authorization": "Bearer $HUB_TOKEN", "X-Hub-Mailbox": "$HUB_MAILBOX" }, "allowedEnvVars": ["HUB_TOKEN", "HUB_MAILBOX"] }] }
    ],
    "PreToolUse": [
      { "matcher": "AskUserQuestion", "hooks": [{ "type": "http", "url": "http://127.0.0.1:7777/events/claude-code", "timeout": 5, "headers": { "Authorization": "Bearer $HUB_TOKEN", "X-Hub-Mailbox": "$HUB_MAILBOX" }, "allowedEnvVars": ["HUB_TOKEN", "HUB_MAILBOX"] }] }
    ],
    "PostToolUse": [
      { "hooks": [{ "type": "http", "url": "http://127.0.0.1:7777/events/claude-code", "timeout": 5, "headers": { "Authorization": "Bearer $HUB_TOKEN", "X-Hub-Mailbox": "$HUB_MAILBOX" }, "allowedEnvVars": ["HUB_TOKEN", "HUB_MAILBOX"] }] }
    ],
    "PostToolUseFailure": [
      { "hooks": [{ "type": "http", "url": "http://127.0.0.1:7777/events/claude-code", "timeout": 5, "headers": { "Authorization": "Bearer $HUB_TOKEN", "X-Hub-Mailbox": "$HUB_MAILBOX" }, "allowedEnvVars": ["HUB_TOKEN", "HUB_MAILBOX"] }] }
    ]
  }
}
