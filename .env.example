# Hub の設定例。実値は .env にコピーして使う (.env はコミットしない)
# 直接起動では 127.0.0.1。Docker では 0.0.0.0 にし、公開は compose の ports で 127.0.0.1 に限定する
HUB_HOST=127.0.0.1
HUB_PORT=7777
# 全 API で必須の共有トークン。十分長いランダム文字列にする
HUB_TOKEN=change-me
# イベント/メッセージの追記ログ保存先
HUB_LOG_DIR=./logs
# role 定義ファイル
HUB_ROLES_FILE=./roles.json

# --- shim 側 (Claude Code の起動環境、または .mcp.json の env で渡す) ---
# HUB_MAILBOX=rev-a
# HUB_ROLE=reviewer
