# Example Hub settings. Copy them to .env and set real values there (do not commit .env)
# Started directly, the Hub uses 127.0.0.1. In Docker (compose.yaml), compose overrides HUB_HOST / HUB_DATA_DIR / HUB_ROLES_FILE, and publishing is limited to 127.0.0.1:HUB_PORT
HUB_HOST=127.0.0.1
HUB_PORT=7777
# Shared token required by every API (16 characters or more). Use the same value for the shim, the hooks and the browser
# Example to generate one: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
HUB_TOKEN=change-me
# Where the append-only log of messages, Mailboxes and events (hub.jsonl) is kept. Default: data/ at the top of the repository
HUB_DATA_DIR=./data
# Role definitions file
HUB_ROLES_FILE=./roles.json
# Attached images (saved in HUB_DATA_DIR/files/). Upper limit of the longer edge of a saved image (px)
HUB_FILE_MAX_EDGE=1568
# How long non-persistent images are kept (days, fractions allowed). 0 means no cleanup
HUB_FILE_TTL_DAYS=1
# How long Messages and Events that were handed over are kept (hours, fractions allowed). Requests awaiting a reply and unread messages are not deleted. 0 means no automatic deletion (design.md §3.14)
HUB_READ_RETENTION_HOURS=24
# Limit on unread messages handed over at attach. Unread messages older than this (days, fractions allowed) or beyond this count are abandoned (they remain in the log). 0 means no limit
HUB_UNREAD_MAX_AGE_DAYS=7
HUB_UNREAD_MAX=50
# Language of text addressed to the human (replies, questions, reports). A BCP 47 language tag (ja, en, pt-BR and so on). Unset means none is specified (design.md §3.5)
# HUB_LANGUAGE=ja
# File that the console output of a Hub started outside Docker is appended to (C143, C158). Default: logs/hub.log. A relative path is resolved from this agent-hub folder. Rotation goes to <file>.1 (usage.md, "Hub log outside Docker")
# HUB_LOG_FILE=logs/hub.log

# --- shim side (set in the environment that starts Claude Code, or in env of .mcp.json) ---
# HUB_MAILBOX=rev-a
# HUB_ROLE=reviewer
# Where attached images are saved (default: agent-hub in the OS temporary folder; a folder per Mailbox name is made under it)
# HUB_FILES_DIR=
