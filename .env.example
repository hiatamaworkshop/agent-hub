# Hub の設定例。実値は .env にコピーして使う (.env はコミットしない)
# 直接起動では 127.0.0.1。Docker (compose.yaml) では HUB_HOST / HUB_DATA_DIR / HUB_ROLES_FILE を compose が上書きし、公開は 127.0.0.1:HUB_PORT に限る
HUB_HOST=127.0.0.1
HUB_PORT=7777
# 全 API で必須の共有トークン (16 文字以上)。shim / hooks / ブラウザで同じ値を使う
# 生成例: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
HUB_TOKEN=change-me
# メッセージ・Mailbox・イベントの追記ログ (hub.jsonl) の保存先。既定はリポジトリ直下の data/
HUB_DATA_DIR=./data
# role 定義ファイル
HUB_ROLES_FILE=./roles.json
# 画像の添付 (HUB_DATA_DIR/files/ に保存)。保存する画像の長辺の上限 (px)
HUB_FILE_MAX_EDGE=1568
# 持続でない画像の保存期間 (日、小数可)。0 なら掃除しない
HUB_FILE_TTL_DAYS=1
# 渡し終えた Message と Event の保存期間 (時間、小数可)。返信待ちの request と未読は消さない。0 なら自動では消さない (design.md §3.14)
HUB_READ_RETENTION_HOURS=24
# attach 時に流す未読の上限。これより古い (日、小数可)・多い未読は放棄済みにする (ログには残る)。0 なら制限なし
HUB_UNREAD_MAX_AGE_DAYS=7
HUB_UNREAD_MAX=50

# --- shim 側 (Claude Code の起動環境、または .mcp.json の env で渡す) ---
# HUB_MAILBOX=rev-a
# HUB_ROLE=reviewer
# 添付画像の保存先 (既定は OS の一時フォルダの agent-hub。その下に Mailbox 名のフォルダを作る)
# HUB_FILES_DIR=
